# Copy to .env and fill in. .env is git-ignored.

# Local OpenAI-compatible endpoint (mlx_lm.server or llama-server)
LLM_BASE_URL=http://127.0.0.1:8091/v1
LLM_MODEL=mlx-community/Qwen3.6-35B-A3B-8bit

# Embeddings (run in-process via sentence-transformers on MPS)
EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B

# Claude is used only as the answer judge
ANTHROPIC_API_KEY=
JUDGE_MODEL=claude-opus-5-5

# Data, DBs and run ledgers live outside OneDrive
POC_DATA_DIR=~/ontology-poc-data
